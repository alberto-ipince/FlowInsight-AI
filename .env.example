# ============================================================
# FlowInsight AI — Variables de Entorno (.env.example)
# ============================================================
# Copia este archivo como .env y ajusta los valores según tu
# entorno de desarrollo local o producción.
#
#   cp .env.example .env
# ============================================================

# -------------------- PostgreSQL ----------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=flowinsight
POSTGRES_USER=flowinsight_user
POSTGRES_PASSWORD=changeme

# -------------------- FastAPI -------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_SECRET_KEY=super-secret-key-change-in-production
BACKEND_CORS_ORIGINS=["http://localhost:5173"]
BACKEND_ENVIRONMENT=development

# -------------------- React / Vite --------------------------
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_TITLE=FlowInsight AI